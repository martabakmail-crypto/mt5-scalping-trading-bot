# MT5 Login Credentials (Leave MT5_LOGIN=0 if MT5 Terminal is already logged in on PC)
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Trading Settings
SYMBOL=XAUUSDc
TIMEFRAME=M5
MIN_SIGNAL_CONFIDENCE=70.0
DEFAULT_LOT=0.01
USE_DYNAMIC_LOT=false
RISK_PERCENT=1.0
MAX_SPREAD_POINTS=50.0

# AI Market Sentiment Filter (Google Gemini API)
USE_AI_FILTER=true
GEMINI_API_KEY=your_google_gemini_api_key_here
AI_MODEL_NAME=gemini-2.5-flash

# Telegram Control & Notifications
ENABLE_TELEGRAM=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
